# Copy to .env (never commit .env). All values are optional for the mock demo.

# Where the local database and private files live. Default: ./data (gitignored).
# Once real bank data is connected, point this OUTSIDE any cloud-synced folder (e.g. OneDrive).
LEDGERPILOT_DATA_DIR=

# Optional: enables opt-in Claude features (smart categorization). Never commit a real key.
ANTHROPIC_API_KEY=
