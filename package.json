{
  "name": "ledgerpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal + S-Corp finance app",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c green,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node scripts/test-api.mjs",
    "test:web": "npm --prefix frontend run typecheck && npm --prefix frontend test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
